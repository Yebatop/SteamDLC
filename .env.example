# --- Обязательное ---------------------------------------------------------
# Ключ Steam Web API: https://steamcommunity.com/dev/apikey
# Нужен, чтобы получить список твоих игр и наигранные часы.
# Можно не задавать здесь, а ввести ключ прямо в интерфейсе (он сохранится
# только в localStorage твоего браузера).
STEAM_API_KEY=

# --- Опционально: история цен и уведомления -------------------------------
# Upstash Redis (бесплатный тариф): https://upstash.com
# Без этих переменных сайт полностью работает, но не хранит историю цен
# и не шлёт уведомления.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Секрет для защиты cron-эндпоинта /api/cron/prices.
# Vercel сам подставляет заголовок Authorization: Bearer $CRON_SECRET.
CRON_SECRET=

# Бот для уведомлений о скидках: создать у @BotFather
TELEGRAM_BOT_TOKEN=
